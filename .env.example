 

# ── Database ─────────────────────────────────
# MongoDB 연결 문자열 (필수)
DB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# ── Site URL ─────────────────────────────────
# 배포 도메인. canonical, OG, RSS, sitemap, 이메일 링크 등 모든 절대 URL 생성에 사용
NEXT_PUBLIC_DEPLOYMENT_URL=http://localhost:3000

# ── Auth (NextAuth + GitHub OAuth) ──────────
# NextAuth 전용. 로컬 개발용이며 Vercel 배포에서는 설정하지 않음
# (Vercel에서는 next-auth가 요청 도메인을 그대로 쓰므로, 값을 넣으면 오히려 도메인 변경 시 로그인이 깨짐)
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32 로 생성
NEXTAUTH_SECRET=
# GitHub OAuth App 의 Client ID / Client Secret
GITHUB_ID=
GITHUB_SECRET=
# 관리자로 인정할 GitHub 계정의 숫자 id (https://api.github.com/users/<username> 의 id)
ADMIN_GITHUB_ID=

# ── GitHub API ───────────────────────────────
# 관리자 댓글 관리에서 utterances 댓글(GitHub Issues) 조회용 토큰
GITHUB_TOKEN=

# ── Email (Resend) ───────────────────────────
# 뉴스레터 구독 인증 메일 발송
RESEND_API_KEY=
EMAIL_FROM=ShipFriend TechBlog <noreply@example.com>

# ── File Upload (Vercel Blob) ────────────────
# 글 이미지 업로드에 사용 (@vercel/blob 이 자동으로 읽음)
BLOB_READ_WRITE_TOKEN=

# ── Build (선택) ─────────────────────────────
# true 로 설정하면 번들 분석 리포트 생성 (pnpm analyze 에서 자동 설정)
# ANALYZE=true
